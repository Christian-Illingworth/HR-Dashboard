{
  "name": "hr-dashboard",
  "private": true,
  "type": "module",
  "description": "Consultiv Utilities HR Dashboard: BrightHR metrics in SharePoint Online.",
  "workspaces": [
    "packages/core",
    "packages/dashboard-ui",
    "apps/sync-function"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/dashboard-ui/tsconfig.json --noEmit && tsc -p apps/sync-function/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"packages/dashboard-ui/src/styles/**/*.css\"",
    "dev:harness": "npm run dev -w @hrd/dashboard-ui",
    "test:e2e": "npm run test:e2e -w @hrd/dashboard-ui",
    "sync:mock": "node --import tsx apps/sync-function/scripts/sync-mock.ts",
    "build:webpart": "node scripts/build-webpart.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
